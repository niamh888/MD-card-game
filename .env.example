# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon connection string (Neon dashboard > Connection details)
DATABASE_URL=

# Random secret for Auth.js. Generate one with: npx auth secret
AUTH_SECRET=

# Resend API key (resend.com > API Keys) and the verified sender address
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="St John Lynch <login@yourdomain.com>"

# Only needed when running "pnpm start" locally (not for "pnpm dev" or Vercel)
AUTH_TRUST_HOST=true
