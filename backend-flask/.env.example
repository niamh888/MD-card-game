# Copy this file to .env and fill in the values. Never commit .env.

# Where the React app runs (used in the sign-in link emailed to people)
FRONTEND_URL=http://localhost:5173

# Optional: send real sign-in emails with Resend (resend.com).
# If these are empty, the sign-in link is printed in this terminal instead, which is fine for development.
RESEND_API_KEY=
EMAIL_FROM="St John Lynch <login@yourdomain.com>"
